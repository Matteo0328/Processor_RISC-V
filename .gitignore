# =====================================================================
# IL2234 project — WHITELIST-ONLY repository policy
# ---------------------------------------------------------------------
# Default: ignore EVERYTHING. Only the sanctioned folders and file types
# below may be committed. This keeps Vivado/QuestaSim working dirs (vivado/,
# work/), logs, toolchain build artifacts and scratch files out of the repo.
#
# Allowed:
#   src/      -> *.sv *.svh *.xdc   (rtl/, tb/, constrs/ at any depth)
#   sim/      -> *.do *.tcl *.f *.sv (QuestaSim scripts / file lists)
#   Firmware/ -> C/assembly build sources only:
#                *.c *.h *.S *.s *.ld *.sh Makefile *.mk *.coe README.md
#                (build artifacts *.o *.elf *.bin *.map *.d ... are ignored)
#   Urbana.xdc (top-level board constraints)
#   (.gitkeep is allowed everywhere so empty folders stay in the repo)
# =====================================================================

# ── 1. Block the entire top level ────────────────────────────────────
/*
# ...then re-allow ONLY these top-level entries.
!/.gitignore
!/README.md
!/Urbana.xdc
!/src/
!/sim/
!/Firmware/

# ── 2. src/ — HDL sources and constraints (any depth) ────────────────
src/**
!src/**/
!src/**/*.sv
!src/**/*.svh
!src/**/*.xdc
!src/**/.gitkeep

# ── 3. sim/ — simulation scripts ─────────────────────────────────────
sim/**
!sim/**/
!sim/**/*.do
!sim/**/*.tcl
!sim/**/*.f
!sim/**/*.sv
!sim/**/.gitkeep

# ── 4. Firmware/ — C/assembly build sources only ─────────────────────
Firmware/**
!Firmware/**/
!Firmware/**/*.c
!Firmware/**/*.h
!Firmware/**/*.S
!Firmware/**/*.s
!Firmware/**/*.ld
!Firmware/**/*.sh
!Firmware/**/*.mk
!Firmware/**/*.coe
!Firmware/**/Makefile
!Firmware/**/README.md
!Firmware/**/.gitkeep